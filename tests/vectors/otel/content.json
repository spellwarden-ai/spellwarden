            {"name": "tool", "attributes": {"gen_ai.operation.name": "execute_tool", "gen_ai.tool.call.arguments": "{\"q\":1}", "gen_ai.tool.call.result": "ok"}}],
  "expect": [{"content": [{"kind": "system", "text": "be brief", "cut": false}, {"kind": "input", "text": "[{\"role\":\"user\",\"content\":\"hi\"}]", "cut": false},
                          {"kind": "output", "text": "[{\"role\":\"assistant\"}]", "cut": false}]},
             {"content": [{"kind": "tool_arguments", "text": "{\"q\":1}", "cut": false}, {"kind": "tool_result", "text": "ok", "cut": false}]}]},
 {"name": "content: legacy and flattened prompt and completion", "signal": "traces", "content": true, "resource": {"service.name": "a"},
  "items": [{"name": "chat", "attributes": {"gen_ai.system": "openai", "gen_ai.operation.name": "chat", "gen_ai.prompt.0.role": "user", "gen_ai.prompt.0.content": "hi",
