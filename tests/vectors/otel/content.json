  "expect": [{"content": [{"kind": "input", "text": "flat", "cut": false}, {"kind": "input", "text": "{\"0.content\":\"hi\",\"0.role\":\"user\"}", "cut": false},
                          {"kind": "output", "text": "{\"0.content\":\"hello\"}", "cut": false}]}]},
 {"name": "content: OpenInference values by span kind", "signal": "traces", "content": true, "resource": {"service.name": "a"},
  "items": [{"name": "llm", "attributes": {"openinference.span.kind": "LLM", "input.value": "q", "output.value": "a", "llm.input_messages.0.message.content": "m"}},
            {"name": "tool", "attributes": {"openinference.span.kind": "TOOL", "input.value": "{\"path\":\"x\"}", "output.value": "file", "tool_call.function.arguments": "{}"}},
            {"name": "retriever", "attributes": {"openinference.span.kind": "RETRIEVER", "input.value": "dropped"}}],
  "expect": [{"content": [{"kind": "input", "text": "{\"0.message.content\":\"m\"}", "cut": false}, {"kind": "input", "text": "q", "cut": false}, {"kind": "output", "text": "a", "cut": false}]},
             {"content": [{"kind": "tool_arguments", "text": "{}", "cut": false}, {"kind": "tool_arguments", "text": "{\"path\":\"x\"}", "cut": false}, {"kind": "tool_result", "text": "file", "cut": false}]},
             {"kind": "other", "$absent": ["content"]}]},
 {"name": "content: GenAI span events are content of their span", "signal": "traces", "content": true, "resource": {"service.name": "a"},
  "items": [{"name": "chat", "attributes": {"gen_ai.operation.name": "chat", "gen_ai.provider.name": "openai"},
             "events": [{"name": "gen_ai.client.inference.operation.details", "attributes": {"gen_ai.input.messages": "in", "gen_ai.output.messages": "out"}},
                        {"name": "gen_ai.user.message", "attributes": {"content": "hello"}},
                        {"name": "exception", "attributes": {"exception.message": "dropped"}}]}],
  "expect": [{"content": [{"kind": "input", "text": "in", "cut": false}, {"kind": "output", "text": "out", "cut": false}, {"kind": "input", "text": "{\"content\":\"hello\"}", "cut": false}]}],
  "stats": {"kept": 1, "content_items": 3}},
 {"name": "content: Claude Code span attributes and the tool.output event", "signal": "traces", "content": true, "resource": {"service.name": "claude-code"},
