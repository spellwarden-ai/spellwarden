[
 {"name": "claude_code: string booleans and integers, the event's own error_type", "signal": "logs", "resource": {"service.name": "claude-code"},
  "items": [{"event_name": "claude_code.tool_result", "attributes": {"tool_name": "Bash", "success": "false", "error_type": "exit_code_1", "duration_ms": "40"}},
            {"event_name": "claude_code.tool_result", "attributes": {"tool_name": "Bash", "success": "false"}},
            {"event_name": "claude_code.tool_result", "attributes": {"tool_name": "Bash", "success": true, "duration_ms": 7}}],
  "expect": [{"status": "error", "error_type": "exit_code_1", "duration_ms": 40}, {"status": "error", "error_type": "tool_error"}, {"status": "ok", "duration_ms": 7}]},
 {"name": "claude_code: tokens add the cache reads and writes", "signal": "logs", "resource": {"service.name": "claude-code"},
  "items": [{"event_name": "claude_code.api_request", "attributes": {"model": "claude-opus-4-1", "input_tokens": "100", "cache_read_tokens": "2000", "cache_creation_tokens": "30", "output_tokens": "45"}}],
  "expect": [{"input_tokens": 2130, "output_tokens": 45, "provider": "anthropic", "model": "claude-opus-4-1"}]},
 {"name": "claude_code: names from tool_parameters", "signal": "logs", "resource": {"service.name": "claude-code"},
  "items": [{"event_name": "claude_code.tool_result", "attributes": {"tool_name": "mcp__github__create_issue", "tool_source": "mcp",
             "tool_parameters": "{\"mcp_server_name\":\"github\",\"mcp_tool_name\":\"create_issue\",\"title\":\"x\"}"}},
            {"event_name": "claude_code.tool_result", "attributes": {"tool_name": "Skill", "tool_parameters": "{\"skill_name\":\"code-review\"}"}},
            {"event_name": "claude_code.tool_result", "attributes": {"tool_name": "Bash", "tool_parameters": "not json"}}],
  "expect": [{"mcp_server_name": "github", "tool_name": "create_issue", "tool_type": "mcp", "$absent": ["names_redacted"]},
             {"skill_name": "code-review", "tool_name": "Skill"}, {"tool_name": "Bash", "$absent": ["mcp_server_name"]}]},
 {"name": "claude_code: a lone surrogate escaped inside tool_parameters is replaced as in the outer strings, a valid pair is kept", "signal": "logs", "resource": {"service.name": "claude-code"},
  "items": [{"event_name": "claude_code.tool_result", "attributes": {"tool_name": "mcp__github__create_issue", "tool_source": "mcp",
             "tool_parameters": "{\"mcp_server_name\":\"git\\ud800hub\",\"mcp_tool_name\":\"create\\udfffissue\"}"}},
            {"event_name": "claude_code.tool_result", "attributes": {"tool_name": "mcp__orders__get_order", "tool_source": "mcp",
             "tool_parameters": "{\"mcp_server_name\":\"orders\\ud83d\\ude00\",\"mcp_tool_name\":\"get_order\"}"}}],
  "expect": [{"mcp_server_name": "git\ufffd\ufffd\ufffdhub", "tool_name": "create\ufffd\ufffd\ufffdissue", "tool_type": "mcp"},
             {"mcp_server_name": "orders\ud83d\ude00", "tool_name": "get_order", "tool_type": "mcp"}]},
 {"name": "claude_code: placeholders set names_redacted", "signal": "logs", "resource": {"service.name": "claude-code"},
  "items": [{"event_name": "claude_code.tool_decision", "attributes": {"tool_name": "mcp_tool", "decision": "accept", "source": "config"}},
            {"event_name": "claude_code.skill_activated", "attributes": {"skill.name": "custom_skill"}},
            {"event_name": "claude_code.tool_result", "attributes": {"tool_name": "Read"}}],
  "expect": [{"names_redacted": true, "tool_name": "mcp_tool"}, {"names_redacted": true}, {"$absent": ["names_redacted"]}]},
 {"name": "claude_code: mcp_other in a span's tool_name_safe is a placeholder; a structured value is not", "signal": "traces", "resource": {"service.name": "claude-code"},
  "items": [{"name": "claude_code.tool", "attributes": {"tool_name": "mcp__x__y", "tool_name_safe": "mcp_other"}},
            {"name": "claude_code.tool", "attributes": {"tool_name": "Read", "tool_name_safe": {"k": "v"}}}],
  "expect": [{"names_redacted": true, "counted": false}, {"tool_name": "Read", "$absent": ["names_redacted"]}]},
 {"name": "claude_code: a safety_event fills the absent fields of its tool_decision and is not emitted", "signal": "logs", "resource": {"service.name": "claude-code"},
  "items": [{"event_name": "claude_code.safety_event", "attributes": {"tool_use_id": "toolu_01B", "decision": "reject", "decision_source": "config",
             "category": "managed_policy", "reason_code": "rule:policySettings", "rule_source": "policySettings"}},
            {"event_name": "claude_code.tool_decision", "attributes": {"tool_use_id": "toolu_01B", "tool_name": "Bash", "decision": "reject", "source": "hook"}}],
  "expect": [{"decision_kind": "tool_decision", "decision_outcome": "reject", "decision_source": "hook", "decision_category": "managed_policy",
              "decision_reason_code": "rule:policySettings", "decision_rule_source": "policySettings", "counted": true}],
  "stats": {"kept": 1, "ignored": 1, "counted": 1}},
 {"name": "claude_code: a disagreeing pair stays apart and the safety_event is uncounted", "signal": "logs", "resource": {"service.name": "claude-code"},
  "items": [{"event_name": "claude_code.tool_decision", "attributes": {"tool_use_id": "toolu_01C", "decision": "accept", "source": "user_temporary"}},
            {"event_name": "claude_code.safety_event", "attributes": {"tool_use_id": "toolu_01C", "decision": "reject", "decision_source": "hook", "category": "hook"}}],
  "expect": [{"decision_kind": "tool_decision", "counted": true, "$absent": ["decision_category"]},
             {"decision_kind": "safety_event", "decision_outcome": "reject", "decision_source": "hook", "decision_category": "hook", "counted": false}]},
 {"name": "claude_code: an unpaired safety_event is uncounted; cancelled reads as reject", "signal": "logs", "resource": {"service.name": "claude-code"},
  "items": [{"event_name": "claude_code.safety_event", "attributes": {"tool_use_id": "toolu_01D", "decision": "cancelled", "decision_source": "user_abort"}}],
  "expect": [{"decision_kind": "safety_event", "decision_outcome": "reject", "counted": false}]},
 {"name": "claude_code: every shape of the event name", "signal": "logs", "resource": {"service.name": "claude-code"},
  "items": [{"event_name": "claude_code.tool_result", "attributes": {"tool_name": "A"}},
            {"body": "claude_code.tool_result", "attributes": {"tool_name": "B"}},
            {"event_name": "tool_result", "attributes": {"tool_name": "C"}},
            {"attributes": {"event.name": "tool_result", "tool_name": "D"}}],
  "expect": [{"tool_name": "A", "name": "claude_code.tool_result"}, {"tool_name": "B"}, {"tool_name": "C"}, {"tool_name": "D"}]},
 {"name": "claude_code: unprefixed names need a claude-code resource", "signal": "logs", "resource": {"service.name": "my-app"},
  "items": [{"event_name": "tool_result", "attributes": {"tool_name": "C"}},
            {"event_name": "claude_code.tool_result", "attributes": {"tool_name": "A"}}],
  "expect": [{"tool_name": "A"}], "stats": {"ignored": 1}},
 {"name": "claude_code: the desktop service counts as Claude Code", "signal": "logs", "resource": {"service.name": "claude-code-desktop"},
  "items": [{"attributes": {"event.name": "skill_activated", "skill.name": "pdf"}}],
  "expect": [{"dialect": "claude_code", "kind": "skill", "skill_name": "pdf"}]}
]
