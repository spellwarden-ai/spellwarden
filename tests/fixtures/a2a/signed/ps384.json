  "provider": {
    "organization": "Example Inc.",
    "url": "https://example.com"
  },
  "capabilities": {
    "streaming": true
  },
  "securitySchemes": {
    "oauth": {
      "oauth2SecurityScheme": {
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://auth.example.com/authorize",
            "tokenUrl": "https://auth.example.com/token",
            "pkceRequired": true,
            "scopes": {
              "invoices.read": "Read invoices"
            }
          }
        }
      }
    }
  },
  "securityRequirements": [
    {
      "schemes": {
        "oauth": {
          "list": [
            "invoices.read"
          ]
        }
      }
    }
