{
  "name": "Invoice Helper",
  "description": "Summarises supplier invoices for the accounts team.",
  "version": "1.2.0",
  "supportedInterfaces": [
    {
      "url": "https://agent.example.com/a2a",
      "protocolBinding": "JSONRPC",
