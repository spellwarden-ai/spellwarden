{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/spellwarden-ai/spellwarden/blob/main/schemas/report.schema.json",
  "title": "Spellwarden scan report (spellwarden scan --format json)",
  "description": "Readers ignore unknown fields (forward compatible). Closed enumerations: item kinds, severities, probe statuses and skip reasons, lock statuses and change kinds, error codes. Notice codes are an open list.",
  "type": "object",
  "required": ["schema", "scanner_version", "rules_version", "as_of", "items", "findings", "probes", "lock", "notices",
               "errors", "fail_on", "exit_code"],
  "properties": {
    "schema": {"const": 1},
    "scanner_version": {"type": "string"},
    "rules_version": {"type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]+$"},
    "as_of": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "probes": {"type": "array", "items": {"$ref": "#/$defs/probe"}},
    "lock": {"$ref": "#/$defs/lock"},
    "notices": {"type": "array", "items": {"$ref": "#/$defs/notice"}},
    "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}},
    "fail_on": {"enum": ["critical", "high", "medium", "low", "never"]},
    "exit_code": {"enum": [0, 1, 2, 3]},
    "connected": {"$ref": "#/$defs/connected"},
    "upload_truncated": {"type": "integer", "minimum": 0, "description": "Findings left out of the upload body to fit its caps."},
    "upload_truncated_fields": {"type": "array", "items": {"type": "string"}, "description": "Fields of the upload body that were cut."}
  },
  "$defs": {
    "connected": {
      "type": "object",
      "description": "Present only when connected mode established its session. Never carries a credential.",
      "required": ["credential", "org", "run", "policy"],
      "properties": {
        "credential": {"enum": ["oidc", "key"]},
        "org": {"type": "object", "required": ["slug", "name"],
                "properties": {"slug": {"type": "string"}, "name": {"type": "string"}}},
        "run": {"type": "object",
                "properties": {"identity": {"type": ["string", "null"]}, "scope": {"type": ["string", "null"]},
                               "kind": {"type": ["string", "null"]}, "event": {"type": ["string", "null"]},
                               "sha": {"type": ["string", "null"]}, "head_sha": {"type": ["string", "null"]},
                               "ref_name": {"type": ["string", "null"]}}},
        "policy": {"type": "object",
                   "properties": {"source": {"type": "string"}, "chosen_by": {"type": "string"},
                                  "pack_id": {"type": ["string", "null"]}, "version": {"type": ["string", "null"]},
                                  "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
                                  "org_rule_ids": {"type": "array", "items": {"type": "string"}},
                                  "skipped": {"type": "array", "items": {
                                    "type": "object", "required": ["id", "why"],
                                    "properties": {"id": {"type": "string"}, "why": {"type": "string"},
                                                   "version": {"type": ["string", "null"]}}}},
                                  "pack_name": {"type": ["string", "null"]},
                                  "registry_name": {"type": ["string", "null"], "description": "The organisation's private registry; null when its plan has none."},
                                  "gate": {"type": "object",
                                           "properties": {"enabled": {"type": "boolean"}, "scope": {"enum": ["changed", "all"]},
                                                          "stdio": {"type": "boolean"}, "plugins": {"type": "boolean"}}}}},
        "registry": {"oneOf": [{"type": "null"}, {
          "type": "object",
          "properties": {"gate": {"type": "boolean"}, "scope": {"type": "string"}, "scope_applied": {"type": "string"},
                         "stdio": {"type": "boolean"}, "plugins": {"type": "boolean"},
                         "checked": {"type": "integer", "minimum": 0}, "not_admitted": {"type": "integer", "minimum": 0},
                         "unidentified": {"type": "integer", "minimum": 0}, "out_of_scope": {"type": "integer", "minimum": 0},
                         "items": {"type": "array", "items": {
                           "type": "object", "required": ["kind", "path", "name"],
                           "properties": {"kind": {"type": "string"}, "path": {"type": "string"}, "name": {"type": "string"},
                                          "identity": {"type": ["string", "null"]}, "reason": {"type": "string"},
                                          "in_scope": {"type": "boolean"}, "admitted": {"type": ["boolean", "null"]},
                                          "request_url": {"type": ["string", "null"]}}}}}}]},
        "upload": {"oneOf": [{"type": "null"}, {
          "type": "object", "required": ["status"],
          "properties": {"status": {"enum": ["uploaded", "failed", "skipped"]}, "attested": {"type": "boolean"},
                         "url": {"type": "string"}, "error": {"type": "string"},
                         "reason": {"enum": ["branch", "event_not_reportable", "default_branch_unconfirmed", "no_run_id",
                                             "local", "disabled"]}}}]}
      }
    },
    "item": {
      "type": "object",
      "required": ["kind", "path", "name", "plugin"],
      "properties": {
        "kind": {"enum": ["skill", "marketplace", "plugin", "mcp-config", "mcp-server", "settings", "hooks", "plugin-manifest"]},
        "path": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "plugin": {"type": ["string", "null"]}
      }
    },
    "finding": {
      "type": "object",
      "required": ["rule_id", "severity", "title", "location", "evidence", "fingerprint", "malicious_indicator", "item",
                   "suppressed", "baseline"],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^SW-(SKL|MCP|CFG|REG|ORG)-[0-9]{3}$"},
        "severity": {"enum": ["critical", "high", "medium", "low"]},
        "title": {"type": "string"},
        "location": {"type": "object", "required": ["path", "line"],
                     "properties": {"path": {"type": "string"}, "line": {"type": ["integer", "null"], "minimum": 1}}},
        "evidence": {"type": "string"},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "malicious_indicator": {"type": "boolean"},
        "item": {"type": "string"},
        "suppressed": {"type": "boolean"},
        "baseline": {"oneOf": [
          {"type": "null"},
          {"type": "object", "required": ["reason", "added", "expires"],
           "properties": {"reason": {"type": "string"}, "added": {"type": "string", "format": "date"},
                          "expires": {"type": "string", "format": "date"}}}
        ]}
      }
    },
    "probe": {
      "type": "object",
      "required": ["item", "status", "skip_reason"],
      "properties": {
        "item": {"type": "string"},
        "status": {"enum": ["probed", "skipped"]},
        "skip_reason": {"enum": [null, "unresolved", "limit", "budget", "fork", "refused"]}
      }
    },
    "change": {
      "type": "object",
      "required": ["kind", "path"],
      "properties": {"kind": {"enum": ["document", "mcp-server", "plugin", "plugin-dir", "skill"]}, "path": {"type": "string"}}
    },
    "lock": {
      "type": "object",
      "required": ["status", "added", "removed", "changed"],
      "properties": {
        "status": {"enum": ["ok", "stale", "absent", "not_checked"]},
        "added": {"type": "array", "items": {"$ref": "#/$defs/change"}},
        "removed": {"type": "array", "items": {"$ref": "#/$defs/change"}},
        "changed": {"type": "array", "items": {"$ref": "#/$defs/change"}}
      }
    },
    "notice": {
      "type": "object",
      "required": ["code", "path", "message"],
      "properties": {"code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "path": {"type": "string"},
                     "message": {"type": "string"}, "detail": {"type": "string"}}
    },
    "error": {
      "type": "object",
      "required": ["code", "path", "message"],
      "properties": {
        "code": {"enum": ["too_large", "not_utf8", "not_json", "duplicate_key", "too_deep", "not_an_object", "truncated",
                          "unsafe_path", "case_collision", "unreadable", "package_too_large", "path_not_directory",
                          "settings_invalid", "baseline_invalid", "lock_unreadable", "invalid_input", "crash",
                          "connected_config", "connected_key_invalid", "connected_no_credential", "connected_auth",
                          "connected_subscription", "connected_ci_key_required", "connected_forbidden",
                          "connected_rate_limited", "connected_unavailable", "connected_required", "policy_not_found",
                          "policy_invalid", "org_rules_incomplete", "registry_check_failed", "registry_check_too_large"]},
        "path": {"type": "string"},
        "message": {"type": "string"}
      }
    }
  }
}
