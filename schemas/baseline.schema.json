{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/spellwarden-ai/spellwarden/blob/main/schemas/baseline.schema.json",
  "title": "Spellwarden baseline (.spellwarden/baseline.yml)",
  "description": "Accepted findings. An entry suppresses the finding with its fingerprint while added <= as-of <= expires; expires - added is at most 365 days, 30 for a malicious-indicator rule. Dates are YAML dates, shown here as ISO strings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "accepted"],
  "properties": {
    "version": {"const": 1},
    "accepted": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint", "rule", "path", "reason", "added", "expires"],
        "properties": {
          "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "rule": {"type": "string", "pattern": "^SW-(SKL|MCP|CFG|REG|A2A|ORG)-[0-9]{3}$"},
          "path": {"type": "string", "minLength": 1, "maxLength": 4096},
          "reason": {"type": "string", "minLength": 1, "maxLength": 4096},
          "added": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "expires": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
        }
      }
    }
  }
}
