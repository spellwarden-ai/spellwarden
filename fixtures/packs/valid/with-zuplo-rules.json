  "org_rules": [
    {
      "id": "SW-ORG-001",
      "title": "Downloads a binary from a raw IP address",
      "severity": "high",
      "area": "skill",
      "owasp": [
        "ASI04"
      ],
      "nist": [
        "SR-3"
      ],
      "targets": [
        "claude-code-hooks",
        "kong",
        "zuplo"
      ],
      "malicious": false,
      "detection": {
        "kind": "pattern",
        "files": "**/*.sh",
        "in": "commands",
        "pattern": "(curl|wget)\\s.*https?://[0-9]{1,3}\\.[0-9]{1,3}\\.",
        "case_sensitive": false
      }
    },
    {
      "id": "SW-ORG-002",
      "title": "Tells the agent to leak the secret",
      "severity": "medium",
      "area": "skill",
      "owasp": [
        "ASI01"
      ],
      "nist": [
        "SI-10"
      ],
      "targets": [
        "zuplo"
      ],
      "malicious": false,
      "detection": {
        "kind": "pattern",
        "files": "**",
        "in": "lines",
        "pattern": "leak the secret$",
        "case_sensitive": true
      }
    },
    {
      "id": "SW-ORG-003",
      "title": "Names a cafe and a delete character",
      "severity": "medium",
      "area": "skill",
      "owasp": [
        "ASI01"
      ],
      "nist": [
        "SI-10"
      ],
      "targets": [
        "zuplo"
      ],
      "malicious": false,
      "detection": {
        "kind": "pattern",
        "files": "**",
        "in": "lines",
        "pattern": "caf\u00e9\u007fbar",
        "case_sensitive": false
      }
    },
    {
      "id": "SW-ORG-004",
      "title": "Repeats a smiley",
      "severity": "medium",
      "area": "skill",
      "owasp": [
        "ASI01"
      ],
      "nist": [
        "SI-10"
      ],
      "targets": [
        "zuplo"
      ],
      "malicious": false,
      "detection": {
        "kind": "pattern",
        "files": "**",
        "in": "lines",
        "pattern": "x\ud83d\ude00+y",
        "case_sensitive": false
      }
    },
    {
      "id": "SW-ORG-005",
      "title": "Smiley inside a class",
      "severity": "medium",
      "area": "skill",
      "owasp": [
        "ASI01"
      ],
      "nist": [
        "SI-10"
      ],
      "targets": [
        "zuplo"
      ],
      "malicious": false,
      "detection": {
        "kind": "pattern",
        "files": "**",
        "in": "lines",
        "pattern": "[a\ud83d\ude00]z",
        "case_sensitive": false
      }
    },
    {
      "id": "SW-ORG-006",
      "title": "Reveals the system prompt",
      "severity": "medium",
      "area": "skill",
      "owasp": [
        "ASI01"
      ],
      "nist": [
        "SI-10"
      ],
      "targets": [
        "kong"
      ],
      "malicious": false,
      "detection": {
        "kind": "pattern",
