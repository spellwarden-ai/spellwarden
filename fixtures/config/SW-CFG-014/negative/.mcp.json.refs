{
  "mcpServers": {
    "tracker": {
      "type": "http",
      "url": "https://mcp.example.com/tracker",
      "headers": {
        "Authorization": "Bearer ${TRACKER_TOKEN}"
      }
    },
    "ledger": {
      "command": "npx",
      "args": ["-y", "ledger-mcp-server", "--api-key", "$LEDGER_KEY"],
      "env": {
        "API_KEY": "${LEDGER_KEY}"
      }
    }
  }
}
